{
	"name": "@drillcoder/voryn",
	"version": "1.1.0",
	"description": "A TypeScript library for reliable EVM indexing with PostgreSQL.",
	"type": "module",
	"engines": {
		"node": ">=22.12"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./sql/postgres-schema.sql": "./dist/sql/postgres-schema.sql"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc && mkdir -p dist/sql && cp src/sql/postgres-schema.sql dist/sql/postgres-schema.sql",
		"build-test": "tsc -p test/tsconfig.json",
		"lint": "eslint --config dev/eslint.config.js .",
		"lint:fix": "npm run lint -- --fix",
		"test:all": "vitest run --config dev/vitest.config.ts",
		"test": "vitest run --config dev/vitest.config.ts test/unit",
		"test:integration": "vitest run --config dev/vitest.config.ts test/integration",
		"test:e2e": "vitest run --config dev/vitest.config.ts test/e2e",
		"test:live-rpc": "vitest run --config dev/vitest.config.ts test/live-rpc",
		"test:unit:coverage": "vitest run --config dev/vitest.config.ts test/unit --coverage",
		"test:coverage": "vitest run --config dev/vitest.config.ts --coverage",
		"test:watch": "vitest --config dev/vitest.config.ts",
		"prepublishOnly": "npm run build",
		"pack:dry-run": "npm pack --dry-run",
		"pack:test": "sh test/package/consumer.sh",
		"db:apply-sql": "tsx --tsconfig dev/tsconfig.json dev/apply-sql.ts",
		"release": "semantic-release",
		"release:dry-run": "semantic-release --dry-run"
	},
	"keywords": [
		"ethers",
		"typescript",
		"web3"
	],
	"author": "drillcoder",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drillcoder/voryn.git"
	},
	"bugs": {
		"url": "https://github.com/drillcoder/voryn/issues"
	},
	"homepage": "https://github.com/drillcoder/voryn#readme",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@drillcoder/ethers-rpc-pool": "^1.0.0",
		"@types/pg": "^8.21.0",
		"ethers": "^6.16.0",
		"pg": "^8.23.0"
	},
	"devDependencies": {
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.8",
		"@semantic-release/npm": "^13.1.5",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@types/node": "^22.0.0",
		"@vitest/coverage-v8": "^5.0.1",
		"conventional-changelog-conventionalcommits": "10.2.1",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-import-newlines": "^1.4.1",
		"eslint-plugin-n": "^18.3.0",
		"prettier": "^3.8.1",
		"semantic-release": "^25.0.5",
		"tsx": "^4.21.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.56.1",
		"vite": "^7.3.6",
		"vitest": "^5.0.1"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"unrs-resolver@1.11.1": true
	}
}
