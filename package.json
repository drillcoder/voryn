{
	"name": "@drillcoder/voryn",
	"version": "0.1.5",
	"description": "TypeScript npm package based on ethers",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./sql/postgres-schema.sql": "./dist/sql/postgres-schema.sql"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rm -rf dist && tsc && mkdir -p dist/sql && cp src/sql/postgres-schema.sql dist/sql/postgres-schema.sql",
		"build-test": "tsc -p test/tsconfig.json",
		"db:apply-sql": "tsx --tsconfig dev/tsconfig.json dev/apply-sql.ts",
		"test": "jest --config dev/jest.config.js",
		"test:unit": "jest --config dev/jest.config.js test/unit",
		"test:integration": "jest --config dev/jest.config.js test/integration",
		"test:e2e": "jest --config dev/jest.config.js test/e2e",
		"test:live-rpc": "jest --config dev/jest.config.js test/live-rpc",
		"test:coverage": "jest --config dev/jest.config.js --coverage",
		"test:watch": "jest --config dev/jest.config.js --watch",
		"lint": "eslint --config dev/eslint.config.js .",
		"lint:fix": "npm run lint -- --fix",
		"prepublishOnly": "npm run build",
		"pack:dry-run": "npm pack --dry-run"
	},
	"keywords": [
		"ethers",
		"typescript",
		"web3"
	],
	"author": "drillcoder",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/drillcoder/voryn.git"
	},
	"bugs": {
		"url": "https://github.com/drillcoder/voryn/issues"
	},
	"homepage": "https://github.com/drillcoder/voryn#readme",
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"ethers": "^6.16.0",
		"pg": "^8.20.0"
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/pg": "^8.18.0",
		"eslint": "^9.39.3",
		"eslint-config-prettier": "^10.1.8",
		"eslint-import-resolver-typescript": "^4.4.4",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-import-newlines": "^1.4.1",
		"eslint-plugin-n": "^17.24.0",
		"jest": "^30.2.0",
		"prettier": "^3.8.1",
		"ts-jest": "^29.4.6",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.56.1"
	}
}
